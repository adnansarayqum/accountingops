{
  "name": "Farhan & Raihan Accounting Operations Hub",
  "short_name": "F&R Ops",
  "description": "Know what's due, what's missing and what's blocked — and share client documents straight in from WhatsApp or email.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/jpeg", "image/png", "image/webp", "image/gif", "application/pdf", "text/plain", ".jpg", ".jpeg", ".png", ".webp", ".gif", ".pdf", ".txt"]
        }
      ]
    }
  }
}
